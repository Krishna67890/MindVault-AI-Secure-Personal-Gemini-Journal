{
  "name": "mindvault-ai-root",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "build": "npm run build --prefix frontend",
    "dev-backend": "npm run dev -w backend",
    "dev-frontend": "npm run dev -w frontend",
    "dev": "concurrently --kill-others \"npm run dev-backend\" \"npm run dev-frontend\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
